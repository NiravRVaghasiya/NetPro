# Docker Compose configuration. Copy to .env and fill in.
# See docs/deployment.md for the full reference.
#
# ── Local-first note ──
# This file is for the Docker/self-hosted path. Plain local use needs none of
# it: `netpro init` + `netpro serve` run on SQLite at ~/.netpro/netpro.db with
# zero environment variables. Local settings live in ~/.netpro/config.toml —
# see docs/local-first.md.

# ── Required ──
POSTGRES_PASSWORD=change-me

# ── Authentication (Phase 5, server-side) ──
# Nothing here is required for local use: `netpro init` + `netpro serve` write
# an installation identity to ~/.netpro/config.toml and trust requests from
# this machine. These settings matter only when callers arrive from elsewhere.
# The standalone `server` service owns authentication (Phase 24 — the Web UI
# has none of its own); the default below is what docker-compose.yml applies.
#
# NETPRO_SERVER_AUTH_MODE=local   # local (default) | token | open
#   local  — requests from this machine are trusted; other callers need the
#            access token (`netpro token`, or NETPRO_AUTH_TOKEN below).
#   token  — every caller, loopback included, presents the access token.
#   open   — NetPro authenticates nobody: only correct behind a reverse proxy,
#            VPN, or private network that does.
NETPRO_SERVER_AUTH_MODE=open

# Present this token when the server is in `token` mode (or to call it from a
# remote machine in `local` mode). `netpro token` prints the value of
# ~/.netpro/keys/access-token.
# NETPRO_AUTH_TOKEN=

# ── Optional: enrichment (bring your own key; unset providers are skipped) ──
# HUNTER_API_KEY=
# PDL_API_KEY=
# CLEARBIT_API_KEY=

# ── Optional: AI outreach drafting (server-side BYO key) ──
# The CLI uses `netpro config set ai.openai.key` instead.
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# ── Optional: semantic search (v2.0 Phase 4 — Postgres only) ──
# Unset = disabled. Search still works everywhere: full-text (FTS5/tsvector)
# needs no key, only `netpro reindex`. This block adds the vector arm on top.
# EMBEDDINGS_PROVIDER=openai        # openai | disabled (default: disabled)
# EMBEDDINGS_API_KEY=               # falls back to OPENAI_API_KEY when provider is set
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=              # any OpenAI-compatible /v1 endpoint
# EMBEDDINGS_DIMENSIONS=            # only if your model supports truncation
# Vectors are written by `netpro reindex --embeddings`, never during import.

# ── Optional: database tuning (see docs/deployment.md) ──
# NETPRO_AUTO_MIGRATE=false   # migrate as an explicit deploy step instead
# NETPRO_DB_POOL_MAX=10
# NETPRO_DB_SSL_CA=           # PEM CA cert, to strictly verify a managed provider

# ── Optional: profile view tracking (v2.5 Phase 2) ──
# Salt for the daily-salted HMAC viewer hashes. Unset falls back to a built-in
# constant. Changing it later only resets the short de-duplication windows —
# never reversible hashes.
# NETPRO_VIEW_SALT=
# true → the view beacons keep answering normally but write no rows.
# NETPRO_DISABLE_VIEWS=

# ── Optional: content tracker providers (v2.5 Phase 5) ──
# Reserved for the disabled devto/twitter/github provider stubs. Setting a
# key changes nothing until a provider implementation ships; `netpro content
# fetch` names the key each disabled provider needs. No provider polls in
# the background.
# DEVTO_API_KEY=
# TWITTER_BEARER_TOKEN=
# GITHUB_TOKEN=

# ── Optional: data retention (v2.5 Phase 6, extended in v3.0 Phase 7) ──
# A daily job (server process since Phase 24, at most one run per 24 h,
# audited in activity_log) purges raw profile views older than 90 days,
# content snapshots older than 365 days (the latest snapshot per piece always
# survives) and webhook delivery-log rows older than 30 days. Garbage values
# fall back to the defaults.
# NETPRO_DISABLE_RETENTION=      # true → no purge ever runs
# NETPRO_VIEW_RETENTION_DAYS=90
# NETPRO_CONTENT_METRIC_RETENTION_DAYS=365
# NETPRO_WEBHOOK_DELIVERY_RETENTION_DAYS=30

# ── Optional: encrypted web provider vault (v3.0 Phase 4) ──
# At least 32 characters; generate with `openssl rand -hex 32`.
# Keep outside the database/backups and preserve it across deployments.
# Missing/short key = read-only vault management, env-only provider resolution.
# Set this to enable Settings → Connect an API (paste-and-save provider keys
# in the web UI, stored AES-256-GCM encrypted).
# ENCRYPTION_MASTER_KEY=

# ── Optional: plugin marketplace (v3.0 Phase 6) ──
# Static index fetched with a plain GET (no telemetry). Override to self-host:
# copy marketplace/ to any static host and point at your index.json.
# MARKETPLACE_INDEX_URL=https://raw.githubusercontent.com/NiravRVaghasiya/NetPro/master/marketplace/index.json
# Directory plugins are installed into and loaded from. Docker Compose sets
# this to /data/plugins on a persistent named volume; a checkout defaults to
# ./plugins.
# NETPRO_PLUGIN_DIR=
# true → never cache the index locally (default: 1-hour local cache).
# MARKETPLACE_NO_CACHE=

# ── Optional: local-first server (Phase 9) ──
# The Web UI (Observatory, Network, People, Activity) talks to the local
# NetPro server at http://127.0.0.1:3777 by default (`netpro serve`). Override
# when the server is on another origin (Docker, remote self-host):
# NEXT_PUBLIC_NETPRO_SERVER_URL=http://127.0.0.1:3777
# NETPRO_SERVER_URL=http://127.0.0.1:3777
# Docker Compose uses NETPRO_SERVER_URL=http://server:3777 inside the web
# container and publishes the API on NETPRO_SERVER_PORT (default 3777).
# NETPRO_SERVER_PORT=3777
# NEXT_PUBLIC_NETPRO_SERVER_URL is a build-time value for browser requests.
# The Activity feed and Observatory's \"Current activity\" subscribe via SSE:
#   EventSource(`${NEXT_PUBLIC_NETPRO_SERVER_URL}/api/events`)
#
# The reverse direction, for humans only: where the Web UI runs, so the
# `netpro serve` banner can point at it instead of implying the API port is
# the UI. Display-only — the server never serves the UI.
# NETPRO_WEB_URL=http://localhost:3000

# ── Optional: remote exposure hardening (Phase 23) ──
# `netpro serve` binds 127.0.0.1 by default; these matter only when callers
# arrive from elsewhere. See docs/deployment.md "Remote exposure checklist".
# NETPRO_HOST=0.0.0.0            # bind off loopback deliberately (or --host)
# NETPRO_ALLOWED_ORIGINS=        # CSV CORS allow-list; unset = loopback origins only
# NETPRO_HSTS=true               # send Strict-Transport-Security (behind TLS only)
# NETPRO_RATE_LIMIT_ENABLED=1    # 0/false/no/off disables (default: on, 600/min/IP)
# NETPRO_RATE_LIMIT_MAX=600
# NETPRO_RATE_LIMIT_WINDOW_MS=60000
# NETPRO_WEBHOOKS_ALLOW_PRIVATE= # 1 → webhooks may target localhost/LAN receivers
