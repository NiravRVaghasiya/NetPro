# Docker Compose configuration. Copy to .env and fill in.
# See docs/deployment.md for the full reference.

# ── Required ──
POSTGRES_PASSWORD=change-me
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Your GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required: numeric GitHub account ID of the only person allowed to sign in.
# Find it with: gh api users/YOUR_USERNAME --jq .id
# This is your user ID, NOT your username and NOT the OAuth client ID.
# Missing/invalid value disables owner sign-in (public cards still work).
NETPRO_OWNER_GITHUB_ID=

# The externally reachable origin of this instance. Used for both NEXTAUTH_URL
# and AUTH_URL — Auth.js only trusts the incoming Host header when one of them
# is set, so a wrong value here makes every signed-in request fail with
# "UntrustedHost". Use your https:// domain behind a TLS-terminating proxy.
APP_URL=http://localhost:3000

# ── Optional: enrichment (bring your own key; unset providers are skipped) ──
# HUNTER_API_KEY=
# PDL_API_KEY=
# CLEARBIT_API_KEY=

# ── Optional: AI outreach drafting (server-side BYO key) ──
# The CLI uses `netpro config set ai.openai.key` instead.
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# ── Optional: database tuning (see docs/deployment.md) ──
# NETPRO_AUTO_MIGRATE=false   # migrate as an explicit deploy step instead
# NETPRO_DB_POOL_MAX=10
# NETPRO_DB_SSL_CA=           # PEM CA cert, to strictly verify a managed provider
