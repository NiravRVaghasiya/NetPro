# Docker Compose configuration. Copy to .env and fill in.
# See docs/deployment.md for the full reference.

# ── Required ──
POSTGRES_PASSWORD=change-me
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Your GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required: numeric GitHub account ID of the only person allowed to sign in.
# Find it with: gh api users/YOUR_USERNAME --jq .id
# This is your user ID, NOT your username and NOT the OAuth client ID.
# Missing/invalid value disables owner sign-in (public cards still work).
NETPRO_OWNER_GITHUB_ID=

# The externally reachable origin of this instance. Used for both NEXTAUTH_URL
# and AUTH_URL — Auth.js only trusts the incoming Host header when one of them
# is set, so a wrong value here makes every signed-in request fail with
# "UntrustedHost". Use your https:// domain behind a TLS-terminating proxy.
APP_URL=http://localhost:3000

# ── Optional: enrichment (bring your own key; unset providers are skipped) ──
# HUNTER_API_KEY=
# PDL_API_KEY=
# CLEARBIT_API_KEY=

# ── Optional: AI outreach drafting (server-side BYO key) ──
# The CLI uses `netpro config set ai.openai.key` instead.
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# ── Optional: semantic search (v2.0 Phase 4 — Postgres only) ──
# Unset = disabled. Search still works everywhere: full-text (FTS5/tsvector)
# needs no key, only `netpro reindex`. This block adds the vector arm on top.
# EMBEDDINGS_PROVIDER=openai        # openai | disabled (default: disabled)
# EMBEDDINGS_API_KEY=               # falls back to OPENAI_API_KEY when provider is set
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=              # any OpenAI-compatible /v1 endpoint
# EMBEDDINGS_DIMENSIONS=            # only if your model supports truncation
# Vectors are written by `netpro reindex --embeddings`, never during import.

# ── Optional: database tuning (see docs/deployment.md) ──
# NETPRO_AUTO_MIGRATE=false   # migrate as an explicit deploy step instead
# NETPRO_DB_POOL_MAX=10
# NETPRO_DB_SSL_CA=           # PEM CA cert, to strictly verify a managed provider

# ── Optional: profile view tracking (v2.5 Phase 2) ──
# Salt for the daily-salted HMAC viewer hashes. Unset falls back to
# NEXTAUTH_SECRET, then a built-in constant. Changing it later only resets
# the short de-duplication windows — never reversible hashes.
# NETPRO_VIEW_SALT=
# true → the view beacons keep answering normally but write no rows.
# NETPRO_DISABLE_VIEWS=

# ── Optional: content tracker providers (v2.5 Phase 5) ──
# Reserved for the disabled devto/twitter/github provider stubs. Setting a
# key changes nothing until a provider implementation ships; `netpro content
# fetch` names the key each disabled provider needs. No provider polls in
# the background.
# DEVTO_API_KEY=
# TWITTER_BEARER_TOKEN=
# GITHUB_TOKEN=

# ── Optional: data retention (v2.5 Phase 6) ──
# A daily job (web process, at most one run per 24 h, audited in
# activity_log) purges raw profile views older than 90 days and content
# snapshots older than 365 days (the latest snapshot per piece always
# survives). Garbage values fall back to the defaults.
# NETPRO_DISABLE_RETENTION=      # true → no purge ever runs
# NETPRO_VIEW_RETENTION_DAYS=90
# NETPRO_CONTENT_METRIC_RETENTION_DAYS=365

# ── Optional: encrypted web provider vault (v3.0 Phase 4) ──
# At least 32 characters; generate with `openssl rand -hex 32`.
# Keep outside the database/backups and preserve it across deployments.
# Missing/short key = read-only vault management, env-only provider resolution.
# ENCRYPTION_MASTER_KEY=
