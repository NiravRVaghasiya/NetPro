POSTGRES_PASSWORD=change-me
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required: numeric GitHub account ID of the only person allowed to sign in.
# Find it with: gh api users/YOUR_USERNAME --jq .id
# Missing/invalid value disables owner sign-in (public cards still work).
NETPRO_OWNER_GITHUB_ID=
APP_URL=http://localhost:3000

# AI outreach (server-side BYO key; the CLI uses `netpro config set ai.openai.key` instead)
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
