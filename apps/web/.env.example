# Local development for apps/web. Copy to .env.local.
# For production deployment (Docker / self-hosted), see docs/deployment.md.

# Phase 24 — the Web UI is a pure client of the standalone NetPro server. It
# opens no database, serves no API routes, and performs no authentication of
# its own, so this file is deliberately tiny: point it at the server and it is
# done. Everything else — database, auth mode, provider keys, migrations, and
# the daily retention purge — belongs to the server (see the repo-root
# .env.example and docs/deployment.md), never to this process.

# ── The server the UI talks to ──
# Server-rendered pages fetch the API from here at request time. Defaults to
# the local server (`netpro serve`): http://127.0.0.1:3777.
NETPRO_SERVER_URL=http://127.0.0.1:3777

# The build-time origin for browser-side requests (SSE event streams, any
# client-side fetches). Same default as NETPRO_SERVER_URL.
NEXT_PUBLIC_NETPRO_SERVER_URL=http://127.0.0.1:3777

# Only needed when the server is in `token` mode or exposed beyond this
# machine — server-rendered pages attach it so they can call the API.
# NETPRO_AUTH_TOKEN=

# ── Event streaming (Phase 8) ──
# The Activity feed and Observatory's "Current activity" subscribe via SSE:
#   EventSource(`${NEXT_PUBLIC_NETPRO_SERVER_URL}/api/events`)
# No configuration is needed for the default local setup; the server's
# /api/events endpoint is loopback-trusted in `local` mode.
