# Local development for apps/web. Copy to .env.local.
# For production deployment (Docker / self-hosted), see docs/deployment.md.

# ── Database ──
# SQLite is the default and needs no configuration at all: without DB_* it is
# `<NETPRO_HOME>/netpro.db` (~/.netpro/netpro.db), the same database the CLI
# and `netpro serve` use. Choose Postgres for a hosted deployment or a team —
# SQLite needs a filesystem that survives restarts.
DB_DIALECT=sqlite
# DB_PATH=./netpro.db                      # relative paths are cwd-relative
# DB_DIALECT=postgresql
# DATABASE_URL=postgresql://netpro:password@localhost:5432/netpro
# Managed providers (Supabase, Neon) sign with their own CA and document
# ?sslmode=require — NetPro maps that to "encrypt, don't verify their CA".
# Use ?sslmode=disable for a private-network database, or set NETPRO_DB_SSL_CA
# to a PEM certificate for strict verification.

# ── Authentication (Phase 5) ──
# Local-first default: no credentials, no OAuth app. Requests whose Host is
# loopback (127.0.0.1, localhost, ::1) and which did not come through a proxy
# are the operator, identified by ~/.netpro/config.toml's installation
# identity. Nothing below is needed to run locally.
#
# NETPRO_AUTH_MODE=local   # local (default when GitHub is unconfigured)
#                          # | github | open
#   local  — trust the operator at this machine; everyone else needs GitHub
#            sign-in (if configured) or their own front door.
#   github — every caller signs in with GitHub. Requires GITHUB_CLIENT_ID,
#            GITHUB_CLIENT_SECRET, NEXTAUTH_SECRET, and (for the break-glass
#            owner) NETPRO_OWNER_GITHUB_ID. Selected automatically when the
#            GitHub pair is present, so existing deployments are unchanged.
#   open   — NetPro authenticates nobody: only behind a reverse proxy, VPN,
#            or private network that does.
#
# In local mode bind/publish this server to 127.0.0.1: the trust decision
# reads the Host header, so a public interface would let a caller claim to be
# local. Expose it with NETPRO_AUTH_MODE=github (or open) instead.
# NETPRO_AUTH_MODE=local
#
# Containers: the socket peer is the Docker bridge rather than loopback, so a
# browser on the host is indistinguishable from a local one. Set this only
# after publishing the port on 127.0.0.1 (docker-compose.yml does, and sets
# it); it asserts "this instance is reachable only from this machine".
# NETPRO_TRUST_LOCAL_UI=1

# ── GitHub OAuth — optional integration (for NETPRO_AUTH_MODE=github) ──
# NEXTAUTH_URL=http://localhost:3000   # the externally reachable origin
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Numeric GitHub account ID of the only account allowed to break the glass:
#   gh api users/YOUR_USERNAME --jq .id
# NETPRO_OWNER_GITHUB_ID=
# AUTH_TRUST_HOST=false   # force host trust off behind an untrusted proxy

# ── Migrations ──
# Migrations are applied on server startup by default. Set this to false when
# you run `npm run db:migrate` as an explicit deploy step (recommended when
# many instances start at once).
# NETPRO_AUTO_MIGRATE=false

# ── Connection pool (optional) ──
# NETPRO_DB_POOL_MAX=10          # 1 when NETPRO_SERVERLESS=1, else 10
# NETPRO_SERVERLESS=1            # many short-lived instances, small pool each
# NETPRO_DB_POOL_IDLE_MS=30000
# NETPRO_DB_CONNECT_TIMEOUT_MS=10000

# ── Enrichment (server-side, host-configured — no per-user key storage) ──
HUNTER_API_KEY=
PDL_API_KEY=
CLEARBIT_API_KEY=

# ── AI outreach (server-side, host-configured BYO key — NetPro never stores keys) ──
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for OpenAI-compatible endpoints
# ANTHROPIC_API_KEY=
# Model overrides (optional):
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Search (v2.0 Phase 4) ──
# Keyword search (SQLite FTS5 / Postgres tsvector) needs no configuration —
# just run `netpro reindex` once to populate the index. The semantic arm below
# is opt-in, Postgres-only, and server-side: the browser never sees the key.
# With nothing set, /search behaves exactly as it did in v1.
# EMBEDDINGS_PROVIDER=openai        # openai | disabled (default: disabled)
# EMBEDDINGS_API_KEY=               # falls back to OPENAI_API_KEY when provider is set
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_DIMENSIONS=            # only if your model supports truncation

# ── Encrypted web provider vault (v3.0 Phase 4) ──
# At least 32 characters; generate with `openssl rand -hex 32`. Keep it
# outside the database and your backups, and preserve it across deployments —
# without it stored credentials cannot be decrypted. Missing/short key =
# read-only vault management in /settings/keys and env-only provider
# resolution (the behaviour v2.5 had).
# ENCRYPTION_MASTER_KEY=

# ── Data retention (v2.5 Phase 6, extended in v3.0 Phase 7) ──
# A daily job in this process (at most one run per 24 h, audited in
# activity_log) purges raw profile views older than 90 days, content
# snapshots older than 365 days (the latest snapshot per piece always
# survives) and webhook delivery-log rows older than 30 days. Garbage values
# fall back to the defaults.
# NETPRO_DISABLE_RETENTION=      # true → no purge ever runs
# NETPRO_VIEW_RETENTION_DAYS=90
# NETPRO_CONTENT_METRIC_RETENTION_DAYS=365
# NETPRO_WEBHOOK_DELIVERY_RETENTION_DAYS=30

# ── Plugins & marketplace (v3.0 Phases 5–6) ──
# Static index fetched with a plain GET (no telemetry). Override to self-host.
# MARKETPLACE_INDEX_URL=https://raw.githubusercontent.com/NiravRVaghasiya/NetPro/master/marketplace/index.json
# Directory plugins are installed into and loaded from (default: ./plugins).
# NETPRO_PLUGIN_DIR=
# true → never cache the index locally (default: 1-hour local cache).
# MARKETPLACE_NO_CACHE=
