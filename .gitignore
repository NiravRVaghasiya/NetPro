# Worktrees
.worktrees/

# Subagent-driven-development scratch (briefs/reports/diffs written inside the worktree)
sdd/

# Dependencies
node_modules/

# Build outputs
dist/
# node-gyp drops `build/` next to any native addon it compiles
# (better-sqlite3), which is easy to commit by accident.
build/
.next/
.turbo/
out/

# Env
.env
.env.local
.env*.local
!.env.example

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Testing
coverage/

# Database
*.db
*.db-journal
# SQLite WAL mode (enabled in packages/db) writes these sidecar files.
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Python (backend/)
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.egg-info/
# `uv.lock` IS committed once it exists — see backend/pyproject.toml.

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
*.tsbuildinfo
