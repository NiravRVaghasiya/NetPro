{
  "name": "@netpro/server",
  "version": "3.0.1",
  "private": true,
  "description": "NetPro local HTTP server \u2014 API, auth, jobs, SSE (local-first; no hosted-platform or Web UI dependency)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts"
  },
  "bin": {
    "netpro-server": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@netpro/core": "^3.0.0",
    "@netpro/db": "^3.0.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@netpro/config": "^3.0.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
