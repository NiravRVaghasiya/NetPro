{
  "name": "netpro",
  "private": true,
  "version": "2.0.0",
  "description": "NetPro \u2014 open source LinkedIn Premium alternative",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:pg": "vitest run --project @netpro/db",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "db:migrate": "npm run build -w @netpro/cli && node apps/cli/dist/index.js migrate",
    "db:migrate:status": "node apps/cli/dist/index.js migrate --status",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
